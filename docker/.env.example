# Claude Code CLI Docker Environment Configuration
# Copy this file to .env and fill in your values

# Project path (absolute or relative to docker-compose.yml)
# Default: current directory and parent
PROJECT_PATH=.

# Anthropic API Key (if needed for Claude Code authentication)
# Get your key from: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Enable skip permissions mode (should be true for CI/CD and automation)
# This prevents interactive permission prompts
CLAUDE_CODE_SKIP_PERMISSIONS=true

# Node environment
NODE_ENV=production

# Optional: Custom working directory inside container
# Default: /workspace
WORK_DIR=/workspace

# Optional: Debug mode (set to 'true' for verbose output)
# DEBUG=false

# Optional: SSH key path for git operations (if using SSH-based git)
# SSH_KEY_PATH=~/.ssh/id_rsa

# Optional: Custom npm registry
# NPM_REGISTRY=https://registry.npmjs.org/

# Optional: HTTP/HTTPS proxy settings (if behind corporate proxy)
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=https://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1

# Optional: Docker resource limits (docker-compose only)
# MEMORY_LIMIT=4G
# CPU_LIMIT=4
